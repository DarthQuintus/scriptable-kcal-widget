/* ---------- Find Health Samples: latest weight ---------- */
/* Type is Weight AND Start Date is in the last 99 years, unit kg,
   sorted Latest First, limit 1. */

action 'filter.health.quantity' findLatestWeight() {
    "WFHKSampleFilteringUnit": "kg",
    "WFContentItemSortProperty": "Start Date",
    "WFContentItemSortOrder": "Latest First",
    "WFContentItemLimitEnabled": true,
    "WFContentItemLimitNumber": 1,
    "WFContentItemFilter": {
        "WFSerializationType": "WFContentPredicateTableTemplate",
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {"Property": "Type", "Operator": 4, "Removable": false, "Bounded": true,
                 "Values": {"Enumeration": {"WFSerializationType": "WFStringSubstitutableState", "Value": "Weight"}}},
                {"Property": "Start Date", "Operator": 1001, "Removable": false, "Bounded": true,
                 "Values": {"Unit": 4, "Number": "99"}}
            ]
        }
    }
}

/* ---------- Find Health Samples: today, not grouped ---------- */
/* Filter: Type is <type> AND Start Date is today. */

action 'filter.health.quantity' findDietaryEnergyToday() {
    "WFHKSampleFilteringUnit": "kcal",
    "WFContentItemFilter": {
        "WFSerializationType": "WFContentPredicateTableTemplate",
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {"Property": "Type", "Operator": 4, "Removable": false, "Bounded": true,
                 "Values": {"Enumeration": {"WFSerializationType": "WFStringSubstitutableState", "Value": "Dietary Calories"}}},
                {"Property": "Start Date", "Operator": 1002, "Removable": false, "Bounded": true,
                 "Values": {"Unit": 16, "Number": 7}}
            ]
        }
    }
}

action 'filter.health.quantity' findProteinToday() {
    "WFHKSampleFilteringUnit": "g",
    "WFContentItemFilter": {
        "WFSerializationType": "WFContentPredicateTableTemplate",
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {"Property": "Type", "Operator": 4, "Removable": false, "Bounded": true,
                 "Values": {"Enumeration": {"WFSerializationType": "WFStringSubstitutableState", "Value": "Protein"}}},
