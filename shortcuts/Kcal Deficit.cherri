/*
Kcal Deficit
------------
Reads the last 7 completed days from Apple Health, calculates the daily
averages (expenditure, intake, macros), adds the current weight and today's
totals, and saves everything as iCloud Drive/Scriptable/kcal.json for the
Scriptable widget (Kcal-Widget.js).

Build with build.py in this folder (runs Cherri, see README):
    python3 build.py "Kcal Deficit.cherri"

Cherri has no built-in Health actions, so "Find Health Samples" and the
"Save File" target folder are declared below as custom actions with their
raw Shortcuts parameters. The date filters refer to the named variables
`Start` and `End` (set with @Start / @End further down).
*/

#include 'actions/calendar'
#include 'actions/device'
#include 'actions/documents'
#include 'actions/math'

#define name Kcal Deficit
#define color darkblue
#define glyph fire

/* ---------- Find Health Samples: 7-day window, grouped by day ---------- */
/* Filter: Type is <type> AND Start Date is between Start and End.
   Group By Day, Fill Missing OFF (unlogged days must not count as 0). */

action 'filter.health.quantity' findActiveEnergy7d() {
    "WFHKSampleFilteringUnit": "kcal",
    "WFHKSampleFilteringGroupBy": "Day",
    "WFHKSampleFilteringFillMissing": false,
    "WFContentItemLimitEnabled": false,
    "WFContentItemFilter": {
        "WFSerializationType": "WFContentPredicateTableTemplate",
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {"Property": "Type", "Operator": 4, "Removable": false, "Bounded": true,
                 "Values": {"Enumeration": {"WFSerializationType": "WFStringSubstitutableState", "Value": "Active Calories"}}},
                {"Property": "Start Date", "Operator": 1003, "Removable": false, "Bounded": true,
                 "Values": {"Unit": 16, "Number": 7,
                            "Date": {"WFSerializationType": "WFTextTokenAttachment", "Value": {"Type": "Variable", "VariableName": "Start"}},
                            "AnotherDate": {"WFSerializationType": "WFTextTokenAttachment", "Value": {"Type": "Variable", "VariableName": "End"}}}}
            ]
        }
    }
}

