            ]
        }
    }
}

/* ---------- Calculate Statistics ---------- */
/* Declared here because Shortcuts expects the samples under the key
   'Input', while Cherri's built-in statistic() writes 'WFInput'. */

action 'statistics' averageOf(variable samples: 'Input') {
    "WFStatisticsOperation": "Average"
}

action 'statistics' sumOf(variable samples: 'Input') {
    "WFStatisticsOperation": "Sum"
}

/* ---------- Save File into iCloud Drive/Scriptable ---------- */

action 'documentpicker.save' saveToScriptable(variable content: 'WFInput', text path: 'WFFileDestinationPath') {
    "WFAskWhereToSave": false,
    "WFSaveFileOverwrite": true,
    "WFFolder": {
        "displayName": "Scriptable",
        "filename": "Documents",
        "fileLocation": {
            "WFFileLocationType": "iCloud",
            "appContainerBundleIdentifier": "dk.simonbs.Scriptable",
            "relativeSubpath": "iCloud~dk~simonbs~Scriptable/Documents"
        }
    }
}

/* ======================================================================= */

// Only run on an iPhone: Health data on an iPad can lag behind and would
// overwrite kcal.json with wrong values.
const DeviceModel = getDeviceDetail("Device Model")
if DeviceModel != "iPhone" {
    stop()
}

// a) Fixed day boundaries: the 7 completed days before today.
const Now = currentDate()
@End = adjustDate(Now, "Get Start of Day")
@Start = adjustDate(End, "Subtract", 7, "days")

// b) 7-day averages (one value per day, missing days are skipped)
const ActiveSamples = findActiveEnergy7d()
const ActiveAverage = averageOf(ActiveSamples)
const Active = round(ActiveAverage)

const RestingSamples = findRestingEnergy7d()
const RestingAverage = averageOf(RestingSamples)

const ExpenditureSum = RestingAverage + ActiveAverage
const Expenditure = round(ExpenditureSum)

const IntakeSamples = findDietaryEnergy7d()
const IntakeAverage = averageOf(IntakeSamples)
const Intake = round(IntakeAverage)

const ProteinSamples = findProtein7d()
const ProteinAverage = averageOf(ProteinSamples)
const Protein = round(ProteinAverage)

const FatSamples = findFat7d()
const FatAverage = averageOf(FatSamples)
const Fat = round(FatAverage)

const CarbsSamples = findCarbs7d()
const CarbsAverage = averageOf(CarbsSamples)
const Carbs = round(CarbsAverage)

// c) Latest weight
const Weight = findLatestWeight()

// d) Today's totals
const TodayIntakeSamples = findDietaryEnergyToday()
const TodayIntakeSum = sumOf(TodayIntakeSamples)
const TodayIntake = round(TodayIntakeSum)

const TodayProteinSamples = findProteinToday()
const TodayProteinSum = sumOf(TodayProteinSamples)
const TodayProtein = round(TodayProteinSum)

const TodayFatSamples = findFatToday()
const TodayFatSum = sumOf(TodayFatSamples)
const TodayFat = round(TodayFatSum)

const TodayCarbsSamples = findCarbsToday()
const TodayCarbsSum = sumOf(TodayCarbsSamples)
const TodayCarbs = round(TodayCarbsSum)

// e) Save the result as kcal.json for the widget
const Result = {
    "Expenditure": "{Expenditure}",
    "Active": "{Active}",
    "Intake": "{Intake}",
    "Protein": "{Protein}",
    "Fat": "{Fat}",
    "Carbs": "{Carbs}",
    "Weight": "{Weight}",
    "TodayIntake": "{TodayIntake}",
    "TodayProtein": "{TodayProtein}",
    "TodayFat": "{TodayFat}",
    "TodayCarbs": "{TodayCarbs}"
}
saveToScriptable(Result, "kcal.json")
